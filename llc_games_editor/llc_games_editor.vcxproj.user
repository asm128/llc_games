<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug-MT' Or '$(Configuration)'=='Release-MT'">
    <LocalDebuggerCommand>$(OutDir)lrt.exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>$(ProjectName)</LocalDebuggerCommandArguments>
  </PropertyGroup>
</Project>
